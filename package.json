{
  "name": "mevrs-origine-fx",
  "version": "0.2.0",
  "description": "App desktop Electron: uscita HDMI a colori reattiva all'audio (MVP).",
  "author": "",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "env -u NODE_OPTIONS vite",
    "build": "pnpm typecheck && env -u NODE_OPTIONS vite build && env -u NODE_OPTIONS electron-builder",
    "start": "env -u NODE_OPTIONS electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@visioncortex/vtracer": "1.0.0-alpha.1",
    "@xenova/transformers": "2.17.2",
    "onnxruntime-web": "1.24.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-txt2img": "0.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "happy-dom": "^20.11.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "build": {
    "appId": "com.mevrs-origine-fx",
    "productName": "Mistica Electronica Visual Reactive Screen",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "config",
        "to": "config",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".coscienza/AGENT.md",
        "to": "coscienza-template/AGENT.md"
      },
      {
        "from": "config/coscienza/COSCIENZA.md",
        "to": "coscienza-template/COSCIENZA.md"
      }
    ],
    "icon": "build/icon",
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Mistica Electronica Visual Reactive Screen usa l'ingresso audio selezionato per generare visual reattivi."
      }
    },
    "win": {
      "icon": "build/icon.ico"
    }
  }
}
